# --- BACKEND (Server) ---
# MongoDB Connection String (e.g. mongodb://localhost:27017/property-listing)
# MONGO_URI=mongodb://localhost:27017/property-listing
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/

# Port for the server (default 5001 to avoid macOS conflict on 5000)
PORT=5001

# JWT Secret for authentication
JWT_SECRET=your_jwt_secret_here

# --- FRONTEND (Client) ---
# API URL (default http://localhost:5001)
NEXT_PUBLIC_API_URL=http://localhost:5001
